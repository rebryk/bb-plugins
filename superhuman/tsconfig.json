{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "*.ts",
    "*.tsx",
    "archive-button",
    "components",
    "haptics",
    "hooks",
    "hotkeys",
    "lib",
    "phone-layout",
    "snooze",
    "title-bar",
    "ui-polish",
    "universal-search",
    "zoom-lock"
  ]
}
